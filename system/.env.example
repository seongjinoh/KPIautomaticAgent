VITE_LLM_PROVIDER=gemini
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_API_KEY=your_google_ai_studio_api_key_here

# KPI 코드체계 API (python server/kpi_api.py)
VITE_API_BASE=http://127.0.0.1:8787

# .env 수정 후 반드시 dev 서버 재시작: npm run dev --prefix system
# Vercel 배포 시에는 Vercel 프로젝트 Environment Variables에 동일 이름으로 등록 후 재배포
